---
import '@fontsource-variable/inter';
import '../../styles/global.css';
import { getCollection } from 'astro:content';
import { ClientRouter } from 'astro:transitions';

const talks = (await getCollection('talks'))
  .filter((talk) => !talk.data.draft)
  .sort((a, b) => (b.data.date?.valueOf() ?? 0) - (a.data.date?.valueOf() ?? 0));

const date = new Intl.DateTimeFormat('en-US', {
  year: 'numeric',
  month: 'short',
  timeZone: 'UTC',
});
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Talks — darccau</title>
    <meta name="description" content="Talks and presentations on application security, tooling, and communities." />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" href="/favicon.ico" type="image/x-icon" sizes="any" />
    <link rel="apple-touch-icon" sizes="120x120" href="/favicon-120.png" />
    <link rel="apple-touch-icon" sizes="152x152" href="/favicon-152.png" />
    <link rel="apple-touch-icon" sizes="167x167" href="/favicon-167.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/favicon-180.png" />
    <ClientRouter />
  </head>
  <body class="bg-white dark:bg-neutral-950">
    <div class="mx-auto">
      <div class="transition-element md:max-w-[460px] m-6 md:m-20 text-neutral-700 dark:text-neutral-300">
        <div class="flex gap-x-4">
          <div class="flex flex-col lowercase">
            <div class="view-transition-avatar w-[36px] h-[36px] mb-8 mt-10 bg-neutral-100 dark:bg-neutral-800 rounded-full shadow-shorter overflow-hidden">
              <a href="/" aria-label="Home" class="text-sm text-neutral-400 font-semibold flex justify-center items-center h-full border-none">
                ep
              </a>
            </div>
            <h1 class="mt-[6px]"><span class="font-semibold">Talks</span></h1>
            <p class="leading-[25px] mt-4 text-neutral-500 dark:text-neutral-400 w-11/12">
              Presentations and workshops on application security, tooling, and the communities I'm part of.
            </p>
          </div>
        </div>

        <div class="mt-10">
          {
            talks.length > 0 ? (
              <ul>
                {talks.map((talk) => (
                  <li>
                    <a
                      href={talk.data.url}
                      class="flex flex-col px-4 -mx-4 py-5 rounded-[12px] border-none hover:bg-neutral-50 dark:hover:bg-neutral-900"
                    >
                      <div class="flex items-baseline justify-between gap-x-4">
                        <div class="text-sm font-semibold leading-snug min-w-0">{talk.data.title}</div>
                        {talk.data.date && (
                          <time
                            datetime={talk.data.date.toISOString()}
                            class="text-xs text-neutral-400 dark:text-neutral-500 tabular-nums whitespace-nowrap flex-shrink-0"
                          >
                            {date.format(talk.data.date)}
                          </time>
                        )}
                      </div>
                      {(talk.data.event || talk.data.location) && (
                        <div class="text-xs text-neutral-400 dark:text-neutral-500 mt-1 leading-[25px]">
                          {talk.data.event}
                          {talk.data.event && talk.data.location && ' · '}
                          {talk.data.location}
                        </div>
                      )}
                      {talk.data.description && (
                        <div class="text-sm text-neutral-500 dark:text-neutral-400 mt-1 leading-[25px]">
                          {talk.data.description}
                        </div>
                      )}
                    </a>
                  </li>
                ))}
              </ul>
            ) : (
              <p class="text-sm text-neutral-400 lowercase">nothing here yet.</p>
            )
          }
        </div>

        <div class="text-sm text-neutral-400 mt-12">
          <a href="/" class="hover:text-neutral-600 dark:hover:text-neutral-200">← back home</a>
        </div>

        <h3 class="view-transition-footer mt-20 mb-40 text-sm text-neutral-400">© 2026 darccau.</h3>
      </div>
    </div>
  </body>
</html>
